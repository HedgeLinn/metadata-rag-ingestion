# RAG-Pro 环境变量模板 — 复制为 .env 或直接 export。
# 零配置即可运行 demo：本地 BGE embedding + --pure 构建 + 纯召回实验，无需任何 LLM/Embedding API。

# ── Qdrant ──
# QDRANT_URL=http://localhost:6333

# ── Embedding（默认 local，本地 BGE 模型，无需密钥）──
# EMBED_SOURCE=local
# EMBED_MODEL_LOCAL=BAAI/bge-small-zh-v1.5
# EMBED_DIM_LOCAL=512

# 备选：自托管 vLLM OpenAI 兼容端点
# EMBED_SOURCE=default
# EMBED_BASE_URL=http://<your-vllm-host>:8004/cloud_ai_service/vllm/v1
# EMBED_API_KEY=dummy
# EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_DIM=1024

# 备选：阿里云 DashScope（OpenAI 兼容）
# EMBED_SOURCE=ali
# EMBED_API_KEY_ALI=your-dashscope-api-key
# EMBED_MODEL_ALI=text-embedding-v4
# EMBED_DIM_ALI=1024

# ── LLM（仅完整实验的生成/评分、元数据生成、llm_index 需要）──
# LLM_BASE_URL=https://<your-openai-compatible-endpoint>/v1
# LLM_API_KEY=your-llm-api-key
# LLM_MODEL=deepseek-v4-pro
# CHUNK_LLM_MODEL=deepseek-v4-flash   # 入库专用模型，默认复用 LLM_BASE_URL/LLM_API_KEY

# ── 其它 ──
# DEFAULT_KB=demo
# BUILD_WORKERS=3
# SCORE_WORKERS=20